# Copy to .env and fill in. .env is gitignored; never commit it.
APP_PASSWORD=change-me            # what the learner types to log in
ANTHROPIC_API_KEY=sk-ant-...      # from https://platform.claude.com/settings/keys
SECRET_KEY=any-long-random-string # signs the login cookie; e.g. python -c "import secrets;print(secrets.token_hex(24))"
